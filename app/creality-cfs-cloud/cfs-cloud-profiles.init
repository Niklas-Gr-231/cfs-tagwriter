#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/python3 /mnt/UDISK/printer_data/config/cfs_cloud_profiles/cloud_service.py --run --config /mnt/UDISK/printer_data/config/cfs_cloud_profiles
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 15
    procd_close_instance
}
